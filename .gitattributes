# 统一文本文件为 CRLF（Windows 开发环境）
* text=auto eol=crlf

# 明确常见文本类型
*.py text eol=crlf
*.pyi text eol=crlf
*.md text eol=crlf
*.yaml text eol=crlf
*.yml text eol=crlf
*.json text eol=crlf
*.toml text eol=crlf
*.txt text eol=crlf
*.sh text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不参与换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
