# EditorConfig：与 .gitattributes 对齐，统一 CRLF
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{py,yml,yaml,json,toml,sh,ps1}]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
